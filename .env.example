# ============================================================================
# WeCom Gateway — configuration
# Copy to wecom-gateway/.env (or repo-root .env) and fill in.
# EVERY credential below is intentionally left blank: the gateway runs in
# mock mode with no secrets. Fill them only when going live.
# ============================================================================

# mock = fully offline simulation (default). live = real WeCom APIs.
WECOM_MODE=mock
WECOM_HOST=127.0.0.1
WECOM_PORT=8100

# --- Database -----------------------------------------------------------------
# WECOM_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/wecom_gateway

# --- WeCom app credentials (fill in later) ------------------------------------
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# --- Session Archive 会话存档 --------------------------------------------------
# pure = RSA/AES via the `cryptography` package (no vendor binary)
# sdk  = official WeCom WeWorkFinanceSdk shared library
WECOM_DECRYPT_PROVIDER=pure
WECOM_ARCHIVE_PRIVATE_KEY_PATH=
WECOM_ARCHIVE_SDK_PATH=

# --- Routing ------------------------------------------------------------------
# Internal employees whose messages must be ignored (comma separated userids)
WECOM_STAFF_USERIDS=
# Group chats that carry orders (comma separated chat ids)
WECOM_ORDER_GROUP_IDS=
# Internal ops chat that receives unresolved-sender alerts
WECOM_INTERNAL_OPS_CHAT_ID=
# Blast-radius control: comma-separated userids/chat_ids. When non-empty, a LIVE
# send to anything else is refused and logged as `blocked`. Leave empty for
# unrestricted sending once destination resolution has been proven on real data.
WECOM_SEND_ALLOWLIST=

# --- Polling ------------------------------------------------------------------
WECOM_ARCHIVE_PULL_INTERVAL=30
WECOM_ARCHIVE_LIMIT=1000
WECOM_ARCHIVE_TIMEOUT=5

# --- Storage ------------------------------------------------------------------
# Shared with the ERP on purpose so intake files are readable off disk.
# WECOM_MEDIA_DIR=/absolute/path/to/backend/data/files/wecom
WECOM_MEDIA_URL_BASE=http://127.0.0.1:8100/wecom/media

# --- ERP connection -----------------------------------------------------------
WECOM_ERP_BASE_URL=http://127.0.0.1:8000
# Dev placeholder that must match the ERP's ERP_SERVICE_KEY. Change BOTH
# together before any real deployment — a mismatch 401s every handoff.
WECOM_ERP_API_KEY=dev-service-key

# Shared secret the ERP must send as X-Gateway-Key on POST /wecom/send
WECOM_GATEWAY_SERVICE_KEY=dev-gateway-key

# Both loopback spellings, and the port Vite falls back to when 5173 is taken.
# The browser decides which one it sends as `Origin`, not us.
WECOM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
