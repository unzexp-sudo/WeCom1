# Keep the build context lean and avoid leaking secrets into the image.
__pycache__/
*.py[cod]
.venv/
venv/
.env
data/
.git/
.gitignore
tests/
simulator/
**/__pycache__/

# Secrets / licensed binaries must never be baked into the image from the repo.
# The SDK .so is fetched at build from the CDN; the private key is mounted at
# runtime from a Railway Volume. Do NOT add them here.
# libWeWorkFinanceSdk.so
# archive_private_key.pem
